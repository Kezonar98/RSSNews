# Root environment variables (single .env for all services)
MONGO_URI=mongodb://mongodb:27017

# Backend service URLs
NEWS_API_URL=http://localhost:8000/news
CATEGORIES_API_URL=http://localhost:8000/categories

# Database settings
DB_NAME=rss_db
COLLECTION_NAME=news

# RSS feed sources
RSS_FEEDS=https://rss.nytimes.com/services/xml/rss/nyt/World.xml, https://rss.cnn.com/rss/edition.rss,https://another.site/feed.xml,https://yetanother.site/rss

# CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:3000,http://localhost:8000/

# API limits
DEFAULT_LIMIT=20

# Frontend (Vite) client URLs
VITE_NEWS_API_URL=http://localhost:8000/news
VITE_CATEGORIES_API_URL=http://localhost:8000/categories

# LLaMA model path (mounted into containers via docker-compose volumes)
LLAMA_MODEL_PATH=/models/llama-3-3b/Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLAMA_NUM_THREADS=4

# Moderation service URL used by rss_fetcher (overridden in docker-compose as well)
MODERATION_SERVICE_URL=http://moderation_service:8002/moderate/article

# Moderation flags and thresholds
TOXICITY_ENABLED=true
DETOXIFY_MODEL=original
BANNED_WORDS=terrorism,drugs,extremism,hate,genocide

MIN_TITLE_WORDS=3
MAX_TITLE_WORDS=20

MAX_DUPLICATE_SENTENCE_RATIO=0.15
MIN_KEYWORD_COVERAGE=0.5
MAX_KEYWORDS=12

# Torch cache (prevents read-only FS issues)
TORCH_HOME=/tmp/torch_cache
